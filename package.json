{
  "name": "ar-tax-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --define:import.meta.env={} --sourcemap --outfile=build/server.cjs",
    "start": "node build/server.cjs",
    "preview": "vite preview",
    "clean": "rimraf dist",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run -c vitest.db.config.ts",
    "test:e2e": "node scripts/e2e/run-e2e.mjs",
    "staging:manifest": "node scripts/staging/migration-manifest.mjs",
    "staging:migration:release-candidate": "tsx scripts/staging/migration-release-candidate.ts",
    "staging:ai-readiness": "tsx scripts/staging/ai-readiness.ts",
    "staging:backup:local": "tsx scripts/staging/backup-rehearsal.ts",
    "security:secrets": "node scripts/staging/scan-secrets.mjs",
    "taxguard:complete": "node scripts/taxguard-complete-system.mjs",
    "qa:fixture:build": "vite build --config qa/synthetic-shell/vite.config.ts",
    "qa:browser:setup": "node scripts/setup-local-browser.mjs",
    "qa:browser": "node scripts/run-local-browser.mjs",
    "qa:browser:product:anonymous": "node scripts/run-local-product-browser.mjs",
    "test:identity": "vitest run staffInvitation staffActivation staffMembership durableMembership staffSessionEpoch staffAccess mfaEnrollment providerOnlyIdentityFlow supabaseStaffMfaClient supabaseProductionInfrastructure productionApiHttp clientDataIsolationSecurity clientOneTimeOnboardingAndProfile finalReleaseGateVerification clientRegistrationAndOnboardingFlow stageTwoReconciliationAuthorization",
    "test:phase10-negative": "vitest run stagingEnvironmentValidator providerValidationTarget billingClientProjection securityEvents malwareScanning healthEndpoints migrationReadinessAudit proposalCompositionSecurity legacyRouteRetirement aiCommissioningMatrix aiGovernedGateway",
    "test:mutation:phase10": "node scripts/mutation/phase10-mutations.mjs",
    "migrations:manifest": "node scripts/migrations/build-migration-manifest.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openai": "^7.23.0",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "embedded-postgres": "17.10.0-beta.17",
    "esbuild": "^0.25.0",
    "playwright-core": "1.64.0",
    "rimraf": "^6.0.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.0.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.64.5",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "lightningcss-linux-x64-gnu": "1.32.0"
  }
}

{
  "name": "TAXGUARD_AI_LEARNING_ENGINE",
  "discovery": "daily",
  "max_documents_per_run": 50,
  "approval": "tiered",
  "storage": "<local path to local-ai/rag>",
  "model": "taxguard-model:8b",
  "inference": "local_only",
  "enabled": false,
  "allow_public_internet_downloads": true,
  "allow_private_data_uploads": false,
  "max_document_bytes": 15000000,
  "max_total_download_bytes_per_run": 150000000,
  "request_timeout_seconds": 45,
  "require_administrator_activation": true,
  "require_human_review_for_sensitive_domains": true
}

# ==============================================================================
# TAXGUARD AI / A/R TAX SERVICES, LLC — ENVIRONMENT VARIABLE CONTRACT
# ==============================================================================
# Classification:
# - [REQUIRED_PRODUCTION]: Mandatory for live production deployment; server fails closed if missing.
# - [PROVIDER_DEPENDENT]: Required when the corresponding external provider integration is active.
# - [OPTIONAL]: System runtime tunables and connection options.
# - [DEVELOPMENT_ONLY]: Used only during local development or testing simulations.
# ==============================================================================

# [REQUIRED_PRODUCTION]
# Canonical tenant identifier for multi-tenant isolation (mandatory in production)
TAXGUARD_TENANT_ID=
# Production database & authentication URL (Supabase PostgreSQL)
SUPABASE_URL=
# Production service role key for administrative server-side operations (NEVER exposed to frontend)
SUPABASE_SERVICE_ROLE_KEY=
# Production anonymous client key
SUPABASE_ANON_KEY=
# Secret key for server-side cryptographically signed tokens
JWT_SECRET=

# [PROVIDER_DEPENDENT - AI]
# Server-side OpenAI API credentials (proposal & drafting layer only; NEVER exposed to frontend)
OPENAI_API_KEY=
OPENAI_MODEL=
TAXGUARD_OPENAI_CASES_ENABLED=

# [PROVIDER_DEPENDENT - EXTERNAL SERVICES]
# Accounting software integrations (QuickBooks / Xero)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Payment processing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Calendar integration
GOOGLE_CALENDAR_CLIENT_ID=
# Document malware scanner daemon
TAXGUARD_MALWARE_SCANNER_ENABLED=

# [OPTIONAL / RUNTIME CONFIGURATION]
# Server listening port (defaults to 3000)
APP_PORT=
# Production PostgreSQL connection URL (optional direct connection pooling)
SUPABASE_DATABASE_URL=

# [FRONTEND PUBLIC CLIENT CONFIGURATION]
# Public API base URL (must start with VITE_; safe for browser exposure)
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PASSWORD_RESET_CONTINUE_URL=

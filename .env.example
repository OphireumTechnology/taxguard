# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Security & Authentication
JWT_SECRET="ar-tax-jwt-secret-key-32-chars-minimum"

# Stripe PCI-compliant payments (Test mode active by default if not set)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Accounting integrations (Sandbox mode active by default if not set)
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""

# Google Calendar / Meet integration
GOOGLE_CALENDAR_CLIENT_ID=""

# Production topology: public build configuration (never place provider keys here).
VITE_API_BASE_URL=""
# Set true ONLY when an actual Express backend/reverse proxy serves /api on the frontend origin.
VITE_API_SAME_ORIGIN="false"
# Leave empty to use Firebase's hosted password reset without a continuation URL.
VITE_PASSWORD_RESET_CONTINUE_URL=""

# Server-only, provisioned through the backend host's secret/configuration store.
TAXGUARD_TENANT_ID=""
FIREBASE_ADMIN_PROJECT_ID=""
FIREBASE_FIRESTORE_DATABASE_ID="(default)"
OPENAI_API_KEY=""
OPENAI_MODEL=""
TAXGUARD_OPENAI_CASES_ENABLED="false"

# Required server configuration
NODE_ENV=development
APP_PORT=3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
TAXGUARD_TENANT_ID=tenantA
TAXGUARD_OPENAI_CASES_ENABLED=false
OPENAI_MODEL=gpt-4o-mini

# Required server secrets
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
OPENAI_API_KEY=your-openai-api-key
JWT_SECRET=your-jwt-secret-key
SUPABASE_DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Public frontend configuration
VITE_API_BASE_URL=http://localhost:3000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_PASSWORD_RESET_CONTINUE_URL=http://localhost:3000/#/client/login

# Optional integrations
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
TAXGUARD_MALWARE_SCANNER_ENABLED=false

{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowJs": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "server.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "src/server/ai",
    "src/server/atomicClientIdentity.ts",
    "src/server/bookkeeperDashboardProjection.ts",
    "src/server/bookkeeperDurableProjection.ts",
    "src/server/clientProfileUpdate.ts",
    "src/server/clientServiceProjection.ts",
    "src/server/taxguard/accountantDocumentReview.service.ts",
    "src/server/taxguard/authority.repository.ts",
    "src/server/taxguard/bookkeeping/bookkeeping.engine.ts",
    "src/server/taxguard/bookkeeping/sqlLedgerStore.ts"
  ]
}

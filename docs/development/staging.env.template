# TaxGuard STAGING environment — variable names only. Never put values in this file or in git.
# Values live in the staging secret store (GitHub "staging" environment secrets / host secret
# manager). Check a candidate configuration offline with:
#   node node_modules/tsx/dist/cli.mjs scripts/staging/check-staging-config.ts
# The protected production project (cvrlhixxczerytiocxid) is refused everywhere.

# Runtime
NODE_ENV=production
PORT=
TAXGUARD_TENANT_ID=

# Separate NON-PRODUCTION Supabase project
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=
VITE_PASSWORD_RESET_CONTINUE_URL=

# Durable stores (development-only routers stay closed unless the owner approves enabling them in staging)
TAXGUARD_PRACTICE_STORE=
TAXGUARD_LEDGER_STORE=
TAXGUARD_LEGACY_ROUTES=retired
# Available only through the approved non-production durable development boundary.
TAXGUARD_SECURITY_EVENTS=
TAXGUARD_LIVE_PAYMENTS_ENABLED=false
TAXGUARD_EFILING_ENABLED=false
TAXGUARD_TAX_SIGNATURES_ENABLED=false

# Uncommissioned features must stay off ("false") until each is approved
TAXGUARD_AI_GOVERNANCE_ENABLED=false
TAXGUARD_OPENAI_CASES_ENABLED=false
TAXGUARD_OCR_ENABLED=false
TAXGUARD_OCR_PROVIDER_MODE=FAIL_SAFE
TAXGUARD_MALWARE_SCANNER_ENABLED=false
TAXGUARD_MFA_RESET_PROVIDER=

# Public consultation requests: per-deployment secret salt for client fingerprints (HMAC)
TAXGUARD_CONSULTATION_FINGERPRINT_SALT=

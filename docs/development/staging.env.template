# TaxGuard STAGING environment — variable names only. Never put values in this file or in git.
# Values live in the staging secret store (GitHub "staging" environment secrets / host secret
# manager). Check a candidate configuration offline (prints field names and codes, never values):
#   node node_modules/tsx/dist/cli.mjs scripts/staging/check-staging-config.ts [--config-file <path>]
# The protected production project (cvrlhixxczerytiocxid) is refused everywhere. Passing the check
# is not a release authorization; every staging step still needs the owner's approval.

# Application identity (server and browser build)
NODE_ENV=production
TAXGUARD_DEPLOYMENT_ENVIRONMENT=staging
VITE_APP_ENV=staging
PORT=
TAXGUARD_LISTEN_HOST=
TAXGUARD_TENANT_ID=
# Production tenant id, used only to prove staging differs (optional)
TAXGUARD_PRODUCTION_TENANT_ID=
TAXGUARD_TRUST_PROXY_HOPS=0

# Hosts: dedicated https origins, never the production domains
TAXGUARD_STAGING_APP_ORIGIN=
TAXGUARD_STAGING_API_ORIGIN=
VITE_API_BASE_URL=
VITE_AUTH_RECOVERY_REDIRECT_URL=

# Separate NON-PRODUCTION Supabase project, positively confirmed
SUPABASE_URL=
VITE_SUPABASE_URL=
TAXGUARD_STAGING_PROJECT_REF=
# Production project ref, used only to prove staging differs (required for the overlap check)
TAXGUARD_PRODUCTION_PROJECT_REF=
SUPABASE_ANON_KEY=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct database connection for migrations only (sslmode=require); leave empty otherwise
DATABASE_URL=

# Durable stores (development-only routers stay closed unless the owner approves enabling them in staging)
TAXGUARD_PRACTICE_STORE=
TAXGUARD_LEDGER_STORE=
TAXGUARD_LEGACY_ROUTES=retired
# Available only through the approved non-production durable development boundary.
TAXGUARD_SECURITY_EVENTS=
TAXGUARD_LIVE_PAYMENTS_ENABLED=false
TAXGUARD_EFILING_ENABLED=false
TAXGUARD_TAX_SIGNATURES_ENABLED=false

# Staff MFA reset provider: empty until the real-provider validation report is recorded
TAXGUARD_MFA_RESET_PROVIDER=
TAXGUARD_MFA_PROVIDER_VALIDATION_RECORDED=

# Uncommissioned features must stay off ("false") until each is approved
TAXGUARD_AI_GOVERNANCE_ENABLED=false
TAXGUARD_OPENAI_CASES_ENABLED=false
TAXGUARD_OCR_ENABLED=false
TAXGUARD_OCR_PROVIDER_MODE=FAIL_SAFE
TAXGUARD_MALWARE_SCANNER_ENABLED=false
# Malware scanner: "disabled" (documents stay quarantined); no provider is commissioned
TAXGUARD_MALWARE_SCANNER=disabled
TAXGUARD_MALWARE_SCANNER_CALLBACK_SECRET=

# Per-environment secrets (at least 32 characters each, never reused)
TAXGUARD_CONSULTATION_FINGERPRINT_SALT=
TAXGUARD_SECURITY_EVENT_FINGERPRINT_SECRET=

# Billing: sandbox keys only (sk_test_...); no live payment keys anywhere
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Not commissioned for staging: must stay empty
OPENAI_API_KEY=
OPENAI_MODEL=
GOOGLE_CLOUD_VISION_KEY=
GOOGLE_CLOUD_ACCESS_TOKEN=
DOCUMENT_AI_PROCESSOR_ID=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SENDGRID_API_KEY=
SMTP_HOST=
GMAIL_CLIENT_ID=
GMAIL_ACCESS_TOKEN=
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_ACCESS_TOKEN=
EMAIL_INGESTION_IMAP_HOST=

# Development shortcuts: must stay empty in staging
TAXGUARD_DEV_EXPOSE_RESET_TOKEN=
TAXGUARD_STAFF_ACCESS_DEVELOPMENT_ENABLED=
TAXGUARD_ALLOW_FAKE_SCANNER=
# Local AI-governance database for disposable development/E2E PostgreSQL only (ignored in production builds).
TAXGUARD_AI_GOVERNANCE_LOCAL_DATABASE_URL=
SEED_STAFF_PASSWORD=
SEED_CLIENT_PASSWORD=

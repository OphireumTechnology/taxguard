          "Content-Type":
            "application/json"
        },

        body:
          JSON.stringify(body)
      }
    );

  if (!response.ok) {

    const error =
      await response.text();

    throw new Error(
      `OpenAI API ${response.status}: ${error}`
    );
  }

  const data =
    await response.json();

  let output = "";

  /*
   * Responses API returns an array of output items.
   */

  for (
    const item of data.output || []
  ) {

    for (
      const part of item.content || []
    ) {

